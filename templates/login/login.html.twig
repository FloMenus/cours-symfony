{% extends 'common/base.html.twig' %}

{% block title %}Connexion · Airstay{% endblock %}

{% block body %}
<div class="min-h-screen bg-white flex items-center justify-center px-4">
    <div class="w-full max-w-[480px]">

        <div class="mb-8 flex items-center justify-between border-b border-[#DDDDDD] pb-5">
            <a href="{{ path('home') }}" class="text-coral-500">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-8 w-8 fill-current">
                    <path d="M16 1C10.5 1 2 11.3 2 18.1c0 4.5 3.1 7.9 7 7.9 2.2 0 4.1-1 5.5-2.6.4-.5.8-1 1.1-1.6.1-.2.2-.4.4-.6.1.2.3.4.4.6.3.6.7 1.1 1.1 1.6 1.4 1.6 3.3 2.6 5.5 2.6 3.9 0 7-3.4 7-7.9C30 11.3 21.5 1 16 1zm6.5 22.9c-1.6 0-3-.8-4-2-.5-.6-1-1.4-1.4-2.2-.4-.9-.9-2-1.1-3.1-.2 1.1-.7 2.2-1.1 3.1-.4.8-.9 1.6-1.4 2.2-1 1.2-2.4 2-4 2-2.8 0-5-2.5-5-5.8 0-5.9 7.6-15.1 12-15.1S27 12.2 27 18.1c0 3.3-2.2 5.8-5 5.8z"/>
                </svg>
            </a>
            <h1 class="text-[18px] font-semibold text-[#222222]">Connexion</h1>
            <a href="{{ path('home') }}" class="rounded-full p-2 hover:bg-[#F7F7F7]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#222222]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </a>
        </div>

        {% if error %}
            <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <p class="mb-6 text-[15px] font-semibold text-[#222222]">Bienvenue sur Airstay</p>

        <form method="post" class="space-y-4">
            <div>
                <label for="username" class="block text-xs font-semibold text-[#222222] mb-1.5">Adresse e-mail</label>
                <input type="email"
                       value="{{ last_username }}"
                       name="_username"
                       id="username"
                       autocomplete="email"
                       required
                       autofocus
                       placeholder="email@exemple.com"
                       class="w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] placeholder-[#717171] focus:outline-none focus:border-[#222222] transition-colors">
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-[#222222] mb-1.5">Mot de passe</label>
                <input type="password"
                       name="_password"
                       id="password"
                       autocomplete="current-password"
                       required
                       placeholder="Votre mot de passe"
                       class="w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] placeholder-[#717171] focus:outline-none focus:border-[#222222] transition-colors">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit"
                    class="w-full rounded-xl bg-gradient-to-r from-coral-500 to-coral-600 py-3.5 text-sm font-semibold text-white hover:from-coral-600 hover:to-coral-600 transition">
                Se connecter
            </button>
        </form>

        <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-[#DDDDDD]"></div>
            </div>
            <div class="relative flex justify-center">
                <span class="bg-white px-4 text-xs text-[#717171]">ou</span>
            </div>
        </div>

        <div class="text-center text-sm text-[#717171]">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-semibold text-[#222222] underline">S'inscrire</a>
        </div>

    </div>
</div>
{% endblock %}
