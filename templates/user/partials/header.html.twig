<header class="sticky top-0 z-30 bg-white border-b border-[#DDDDDD]">
    <div class="mx-auto flex max-w-[1760px] items-center justify-between gap-4 px-6 py-4 lg:px-10">

        <a href="{{ path('home') }}" class="shrink-0 flex items-center gap-1 text-coral-500">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-8 w-8 fill-current">
                <path d="M16 1C10.5 1 2 11.3 2 18.1c0 4.5 3.1 7.9 7 7.9 2.2 0 4.1-1 5.5-2.6.4-.5.8-1 1.1-1.6.1-.2.2-.4.4-.6.1.2.3.4.4.6.3.6.7 1.1 1.1 1.6 1.4 1.6 3.3 2.6 5.5 2.6 3.9 0 7-3.4 7-7.9C30 11.3 21.5 1 16 1zm6.5 22.9c-1.6 0-3-.8-4-2-.5-.6-1-1.4-1.4-2.2-.4-.9-.9-2-1.1-3.1-.2 1.1-.7 2.2-1.1 3.1-.4.8-.9 1.6-1.4 2.2-1 1.2-2.4 2-4 2-2.8 0-5-2.5-5-5.8 0-5.9 7.6-15.1 12-15.1S27 12.2 27 18.1c0 3.3-2.2 5.8-5 5.8z"/>
            </svg>
            <span class="hidden text-lg font-bold lg:block">airstay</span>
        </a>

        <div class="flex flex-1 justify-center">
            <div class="flex items-center rounded-full border border-[#DDDDDD] shadow-sm hover:shadow-md transition-shadow text-sm divide-x divide-[#DDDDDD]">
                <span class="px-5 py-3 font-semibold text-[#222222] hover:bg-[#F7F7F7] rounded-l-full cursor-pointer">Partout</span>
                <span class="px-5 py-3 font-semibold text-[#222222] hover:bg-[#F7F7F7] cursor-pointer">N'importe quand</span>
                <div class="flex items-center gap-3 pl-5 pr-2 py-2 hover:bg-[#F7F7F7] rounded-r-full cursor-pointer">
                    <span class="text-[#717171]">Ajouter des voyageurs</span>
                    <button class="flex items-center justify-center w-8 h-8 rounded-full bg-coral-500 text-white shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="relative flex shrink-0 items-center gap-1">
            <a href="{{ path('property_new') }}" class="hidden rounded-full px-4 py-2.5 text-sm font-semibold text-[#222222] hover:bg-[#F7F7F7] lg:block whitespace-nowrap">Proposer un logement</a>

            <button class="rounded-full p-2.5 text-[#222222] hover:bg-[#F7F7F7]" title="Choisir une langue">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
                </svg>
            </button>

            <div class="relative">
                <button id="user-menu-btn"
                        class="flex items-center gap-2 rounded-full border border-[#DDDDDD] px-3 py-2 hover:shadow-md transition-shadow">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#222222]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-[#717171] text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
                        </svg>
                    </div>
                    {% if app.user %}
                        <span class="hidden text-xs font-semibold text-[#222222] lg:block max-w-[80px] truncate">{{ app.user.email|split('@')[0] }}</span>
                    {% endif %}
                </button>

                <div id="user-menu-dropdown"
                     class="absolute right-0 top-14 w-60 rounded-xl border border-[#DDDDDD] bg-white py-2 shadow-lg z-50 hidden">
                    {% if app.user %}
                        <div class="px-4 py-2 text-xs font-semibold text-[#222222] border-b border-[#DDDDDD] mb-1">{{ app.user.email }}</div>
                        <a href="{{ path('reservation_list') }}" class="block px-4 py-2.5 text-sm text-[#222222] hover:bg-[#F7F7F7]">Mes réservations</a>
                        <div class="border-t border-[#DDDDDD] my-1"></div>
                        <a href="{{ path('app_logout') }}" class="block px-4 py-2.5 text-sm text-[#222222] hover:bg-[#F7F7F7]">Se déconnecter</a>
                    {% else %}
                        <a href="{{ path('app_register') }}" class="block px-4 py-2.5 text-sm font-semibold text-[#222222] hover:bg-[#F7F7F7]">S'inscrire</a>
                        <a href="{{ path('app_login') }}" class="block px-4 py-2.5 text-sm text-[#222222] hover:bg-[#F7F7F7]">Se connecter</a>
                        <div class="border-t border-[#DDDDDD] my-1"></div>
                        <a href="{{ path('property_new') }}" class="block px-4 py-2.5 text-sm text-[#222222] hover:bg-[#F7F7F7]">Proposer un logement</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="border-t border-[#DDDDDD]">
        <div class="mx-auto flex max-w-[1760px] items-center justify-between px-6 lg:px-10">
            <div class="flex items-center gap-6 overflow-x-auto py-3 scrollbar-hide">
                {% set categories = [
                    { icon: '🏖️', label: 'Plages' },
                    { icon: '🏡', label: 'Campagne' },
                    { icon: '🌊', label: 'Piscines incroyables' },
                    { icon: '🏔️', label: 'Montagne' },
                    { icon: '🌆', label: 'Villes' },
                    { icon: '🛖', label: 'Cabanes' },
                    { icon: '⛵', label: 'Bateaux' },
                    { icon: '🏰', label: 'Châteaux' },
                    { icon: '🌴', label: 'Tropiques' },
                    { icon: '❄️', label: 'Arctique' },
                    { icon: '🌋', label: 'Volcans' },
                    { icon: '🧖', label: 'Design' },
                ] %}
                {% for cat in categories %}
                    <button class="flex shrink-0 flex-col items-center gap-1.5 border-b-2 border-transparent pb-2 pt-1 text-[#717171] hover:border-[#222222] hover:text-[#222222] transition-colors">
                        <span class="text-2xl">{{ cat.icon }}</span>
                        <span class="text-xs font-medium whitespace-nowrap">{{ cat.label }}</span>
                    </button>
                {% endfor %}
            </div>
            <button class="hidden lg:flex shrink-0 ml-4 items-center gap-2 rounded-xl border border-[#DDDDDD] px-4 py-2.5 text-sm font-semibold text-[#222222] hover:border-[#222222] transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707l-6.414 6.414A1 1 0 0014 13.828V19a1 1 0 01-.553.894l-4 2A1 1 0 018 21v-7.172a1 1 0 00-.293-.707L1.293 6.707A1 1 0 011 6V4z"/>
                </svg>
                Filtres
            </button>
        </div>
    </div>
</header>

<script>
(function () {
    function initDropdown() {
        const btn      = document.getElementById('user-menu-btn');
        const dropdown = document.getElementById('user-menu-dropdown');
        if (!btn || !dropdown) return;

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
        });

        document.addEventListener('click', function (e) {
            if (!dropdown.contains(e.target)) {
                dropdown.classList.add('hidden');
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDropdown);
    } else {
        initDropdown();
    }
})();
</script>
