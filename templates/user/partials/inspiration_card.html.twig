<article class="overflow-hidden rounded-3xl bg-gradient-to-br {{ inspiration.gradient }} p-6 text-white shadow-soft">
    <p class="text-xs font-bold uppercase tracking-wide text-white/80">{{ inspiration.tag }}</p>
    <h3 class="mt-2 text-xl font-black">{{ inspiration.city }}</h3>
    <p class="mt-2 text-sm text-white/90">{{ inspiration.description }}</p>
</article>
