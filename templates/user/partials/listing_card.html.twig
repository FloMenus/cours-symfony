<a href="{{ path('property_show', { id: property.id }) }}" class="group block">
    <div class="relative overflow-hidden rounded-xl aspect-square bg-[#EBEBEB]">
        <img
            src="{{ asset('images/house-placeholder.svg') }}"
            alt="{{ property.title }}"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
        >
        <button onclick="event.preventDefault(); this.classList.toggle('favorited')"
                class="heart-btn absolute top-3 right-3 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                      fill="none" stroke="white" stroke-width="2.5"/>
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                      fill="rgba(0,0,0,0.5)" stroke="none" class="heart-bg"/>
            </svg>
        </button>
        {% if property.instantBooking %}
            <span class="absolute top-3 left-3 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-[#222222] shadow-sm">Réservation instantanée</span>
        {% endif %}
    </div>
    <div class="mt-3 px-0.5">
        <div class="flex items-start justify-between gap-2">
            <p class="font-semibold text-[#222222] truncate text-[15px]">{{ property.title }}</p>
            <div class="flex shrink-0 items-center gap-1 text-[#222222]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="text-sm">Nouveau</span>
            </div>
        </div>
        <p class="text-sm text-[#717171]">{{ property.propertyType|capitalize }}</p>
        <p class="text-sm text-[#717171]">{{ property.bedrooms }} chambre{{ property.bedrooms > 1 ? 's' : '' }} · {{ property.beds }} lit{{ property.beds > 1 ? 's' : '' }}</p>
        <p class="mt-1 text-[15px]"><span class="font-semibold text-[#222222]">{{ property.pricePerNight|number_format(0, ',', ' ') }}€</span> <span class="text-[#222222]">nuit</span></p>
    </div>
</a>

<style>
.heart-btn .heart-bg { fill: rgba(0,0,0,0.5); transition: fill 0.15s; }
.heart-btn:hover .heart-bg { fill: rgba(0,0,0,0.7); }
.heart-btn.favorited .heart-bg { fill: #FF385C; }
.heart-btn.favorited svg path:first-child { stroke: #FF385C; }
</style>
