{% extends 'user/layout.html.twig' %}

{% form_theme form _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <p class="mt-1.5 text-xs font-medium text-red-600">{{ error.message }}</p>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block title %}Proposer un logement · Airstay{% endblock %}

{% block user_header %}
    {% include 'user/partials/header.html.twig' %}
{% endblock %}

{% block user_content %}
<div class="mx-auto max-w-[720px] px-6 py-10 lg:px-10">

    <h1 class="text-2xl font-semibold text-[#222222] mb-2">Proposer votre logement</h1>
    <p class="text-sm text-[#717171] mb-10">Votre annonce sera enregistrée en brouillon. Vous pourrez la publier plus tard.</p>

    {{ form_start(form, { attr: { class: 'space-y-8', novalidate: 'novalidate' } }) }}

        <div class="rounded-2xl border border-[#DDDDDD] p-6 space-y-5">
            <h2 class="text-base font-semibold text-[#222222]">Informations générales</h2>

            <div>
                {{ form_label(form.title, 'Titre de l\'annonce', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.title, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', placeholder: 'Ex : Chalet vue lac à Annecy' } }) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.description, 'Description', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.description, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', rows: 4, placeholder: 'Décrivez votre logement...' } }) }}
                {{ form_errors(form.description) }}
            </div>

            <div>
                {{ form_label(form.propertyType, 'Type de logement', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.propertyType, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors bg-white' } }) }}
                {{ form_errors(form.propertyType) }}
            </div>
        </div>

        <div class="rounded-2xl border border-[#DDDDDD] p-6 space-y-5">
            <h2 class="text-base font-semibold text-[#222222]">Capacité</h2>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.maxGuests, 'Voyageurs max', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.maxGuests, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', min: 1 } }) }}
                    {{ form_errors(form.maxGuests) }}
                </div>
                <div>
                    {{ form_label(form.bedrooms, 'Chambres', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.bedrooms, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', min: 1 } }) }}
                    {{ form_errors(form.bedrooms) }}
                </div>
                <div>
                    {{ form_label(form.beds, 'Lits', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.beds, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', min: 1 } }) }}
                    {{ form_errors(form.beds) }}
                </div>
                <div>
                    {{ form_label(form.bathrooms, 'Salles de bain', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.bathrooms, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', min: 1 } }) }}
                    {{ form_errors(form.bathrooms) }}
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-[#DDDDDD] p-6 space-y-5">
            <h2 class="text-base font-semibold text-[#222222]">Tarifs</h2>

            <div>
                {{ form_label(form.pricePerNight, 'Prix par nuit (€)', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.pricePerNight, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', placeholder: '0.00' } }) }}
                {{ form_errors(form.pricePerNight) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.cleaningFee, 'Frais de ménage (€)', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.cleaningFee, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', placeholder: 'Optionnel' } }) }}
                    {{ form_errors(form.cleaningFee) }}
                </div>
                <div>
                    {{ form_label(form.securityDeposit, 'Caution (€)', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                    {{ form_widget(form.securityDeposit, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors', placeholder: 'Optionnel' } }) }}
                    {{ form_errors(form.securityDeposit) }}
                </div>
            </div>
        </div>

        <div class="rounded-2xl border border-[#DDDDDD] p-6 space-y-5">
            <h2 class="text-base font-semibold text-[#222222]">Options</h2>

            <div>
                {{ form_label(form.cancellationPolicy, 'Politique d\'annulation', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.cancellationPolicy, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors bg-white' } }) }}
                {{ form_errors(form.cancellationPolicy) }}
            </div>

            <div class="flex items-center gap-3">
                {{ form_widget(form.instantBooking, { attr: { class: 'h-4 w-4 rounded border-[#DDDDDD] text-coral-500 focus:ring-coral-400' } }) }}
                {{ form_label(form.instantBooking, 'Réservation instantanée', { label_attr: { class: 'text-sm font-medium text-[#222222]' } }) }}
            </div>
        </div>

        <div class="flex items-center justify-between">
            <a href="{{ path('home') }}" class="text-sm font-semibold text-[#717171] underline hover:text-[#222222]">
                Annuler
            </a>
            <button type="submit"
                    class="rounded-xl bg-gradient-to-r from-coral-500 to-coral-600 px-8 py-3.5 text-sm font-semibold text-white hover:from-coral-600 hover:to-coral-600 transition">
                Enregistrer le logement
            </button>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
