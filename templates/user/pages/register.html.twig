{% extends 'user/layout.html.twig' %}

{% block title %}Créer un compte · Airstay{% endblock %}

{% block user_content %}
<div class="flex min-h-screen items-center justify-center bg-white px-4 py-16">
    <div class="w-full max-w-[480px]">

        <div class="mb-8 flex items-center justify-between border-b border-[#DDDDDD] pb-5">
            <h1 class="text-[18px] font-semibold text-[#222222]">Créer un compte</h1>
            <a href="{{ path('home') }}" class="rounded-full p-2 hover:bg-[#F7F7F7]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#222222]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </a>
        </div>

        {{ form_start(form, { attr: { class: 'space-y-4', novalidate: 'novalidate' } }) }}

            <div>
                {{ form_label(form.email, 'Adresse e-mail', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.email, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] placeholder-[#717171] focus:outline-none focus:border-[#222222] transition-colors', placeholder: 'Adresse e-mail' } }) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ form_label(form.phone, 'Téléphone (optionnel)', { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.phone, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] placeholder-[#717171] focus:outline-none focus:border-[#222222] transition-colors', placeholder: '+33 6 00 00 00 00' } }) }}
                {{ form_errors(form.phone) }}
            </div>

            <div>
                {{ form_label(form.plainPassword.first, null, { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.plainPassword.first, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors' } }) }}
                {{ form_errors(form.plainPassword.first) }}
            </div>

            <div>
                {{ form_label(form.plainPassword.second, null, { label_attr: { class: 'block text-xs font-semibold text-[#222222] mb-1.5' } }) }}
                {{ form_widget(form.plainPassword.second, { attr: { class: 'w-full rounded-xl border border-[#DDDDDD] px-4 py-3 text-sm text-[#222222] focus:outline-none focus:border-[#222222] transition-colors' } }) }}
                {{ form_errors(form.plainPassword.second) }}
            </div>

            <p class="text-xs text-[#717171] leading-relaxed">
                En cliquant sur Continuer, vous acceptez les <a href="#" class="underline text-[#222222]">Conditions d'utilisation</a> et la <a href="#" class="underline text-[#222222]">Politique de confidentialité</a> d'Airstay.
            </p>

            <button type="submit"
                    class="w-full rounded-xl bg-gradient-to-r from-coral-500 to-coral-600 py-3.5 text-sm font-semibold text-white hover:from-coral-600 hover:to-coral-600 transition">
                Continuer
            </button>

        {{ form_end(form) }}

        <div class="mt-5 flex items-center gap-4 text-sm text-[#717171]">
            <span>Déjà un compte ?</span>
            <a href="#" class="font-semibold text-[#222222] underline">Se connecter</a>
        </div>
    </div>
</div>
{% endblock %}
