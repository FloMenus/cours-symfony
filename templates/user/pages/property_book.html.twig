{% extends 'user/layout.html.twig' %}

{% block title %}Demande de réservation · {{ property.title }}{% endblock %}

{% form_theme form _self %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <p class="mt-1.5 text-xs font-medium text-red-600">{{ error.message }}</p>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block user_header %}
    {% include 'user/partials/header.html.twig' %}
{% endblock %}

{% block user_content %}
<div class="mx-auto max-w-[900px] px-6 py-10 lg:px-10">

    <a href="{{ path('property_show', { id: property.id }) }}" class="flex items-center gap-2 text-sm font-semibold text-[#222222] hover:text-[#717171] mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour à l'annonce
    </a>

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">

        <div>
            <h1 class="text-2xl font-semibold text-[#222222] mb-2">Demande de réservation</h1>
            <p class="text-sm text-[#717171] mb-8">Aucun montant ne sera débité pour le moment.</p>

            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="overflow-hidden rounded-xl border border-[#DDDDDD] mb-4">
                    <div class="grid grid-cols-2 divide-x divide-[#DDDDDD]">
                        <label class="block p-3 hover:bg-[#F7F7F7] cursor-pointer">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-[#222222]">Arrivée</p>
                            {{ form_widget(form.checkinDate, { attr: { class: 'mt-1 w-full border-0 p-0 text-sm text-[#222222] bg-transparent focus:outline-none focus:ring-0' } }) }}
                            {{ form_errors(form.checkinDate) }}
                        </label>
                        <label class="block p-3 hover:bg-[#F7F7F7] cursor-pointer">
                            <p class="text-[10px] font-bold uppercase tracking-wide text-[#222222]">Départ</p>
                            {{ form_widget(form.checkoutDate, { attr: { class: 'mt-1 w-full border-0 p-0 text-sm text-[#222222] bg-transparent focus:outline-none focus:ring-0' } }) }}
                            {{ form_errors(form.checkoutDate) }}
                        </label>
                    </div>
                    <label class="block border-t border-[#DDDDDD] p-3 hover:bg-[#F7F7F7]">
                        <p class="text-[10px] font-bold uppercase tracking-wide text-[#222222]">Voyageurs</p>
                        {{ form_widget(form.guestsCount, { attr: { class: 'mt-1 w-full border-0 p-0 text-sm text-[#222222] bg-transparent focus:outline-none focus:ring-0', min: 1, max: property.maxGuests } }) }}
                        {{ form_errors(form.guestsCount) }}
                    </label>
                </div>

                <button type="submit"
                        class="w-full rounded-lg bg-gradient-to-r from-coral-500 to-coral-600 py-3.5 text-sm font-semibold text-white hover:from-coral-600 hover:to-coral-600 transition">
                    Confirmer la réservation
                </button>

                <p class="mt-2 text-center text-xs text-[#717171]">Maximum {{ property.maxGuests }} voyageurs</p>

            {{ form_end(form) }}
        </div>

        <div>
            <div class="rounded-xl border border-[#DDDDDD] p-5">
                <div class="flex gap-4">
                    <div class="h-24 w-24 shrink-0 rounded-xl bg-[#EBEBEB]"></div>
                    <div>
                        <p class="text-xs text-[#717171]">{{ property.propertyType|capitalize }}</p>
                        <p class="font-semibold text-[#222222]">{{ property.title }}</p>
                        <div class="mt-2 flex items-center gap-1 text-xs">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 fill-current" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            Nouveau
                        </div>
                    </div>
                </div>
                <div class="mt-5 border-t border-[#DDDDDD] pt-5 space-y-3 text-sm">
                    <h3 class="font-semibold text-[#222222]">Détail du prix</h3>
                    <div class="flex justify-between text-[#222222]">
                        <span class="underline">{{ property.pricePerNight }}€ × nuit</span>
                        <span>{{ property.pricePerNight }}€</span>
                    </div>
                    {% if property.cleaningFee %}
                        <div class="flex justify-between text-[#222222]">
                            <span class="underline">Frais de ménage</span>
                            <span>{{ property.cleaningFee }}€</span>
                        </div>
                    {% endif %}
                    {% if property.securityDeposit %}
                        <div class="flex justify-between text-[#717171]">
                            <span class="underline">Caution</span>
                            <span>{{ property.securityDeposit }}€</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
