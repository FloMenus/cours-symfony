{% extends 'user/layout.html.twig' %}

{% block title %}Airstay · Des logements uniques partout dans le monde{% endblock %}

{% block user_header %}
    {% include 'user/partials/header.html.twig' %}
{% endblock %}

{% block user_content %}
    <div class="mx-auto max-w-[1760px] px-6 py-8 lg:px-10">
        <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {% for property in properties %}
                {% include 'user/partials/listing_card.html.twig' with { property: property } only %}
            {% endfor %}
        </div>
    </div>

    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-20">
        <button class="flex items-center gap-2 rounded-full bg-[#222222] px-5 py-3 text-sm font-semibold text-white shadow-lg hover:bg-[#000000] transition-colors">
            Afficher la carte
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
        </button>
    </div>
{% endblock %}

{% block user_footer %}
    {% include 'user/partials/footer.html.twig' with { footer_columns: footer_columns } only %}
{% endblock %}
