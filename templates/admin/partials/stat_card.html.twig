<article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">{{ stat.label }}</p>
    <p class="mt-2 text-3xl font-black text-slate-900">{{ stat.value }}</p>
    <p class="mt-2 text-sm font-semibold {{ stat.delta starts with '+' ? 'text-emerald-600' : 'text-rose-600' }}">{{ stat.delta }}</p>
</article>
